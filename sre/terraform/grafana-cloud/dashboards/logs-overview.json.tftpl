            "uid": "${loki_datasource_uid}"
          },
          "expr": "topk(10, sum by (container) (count_over_time({deployment_environment=\"${environment}\", service_namespace=~\"$${service_namespace:regex}\", service_name=~\"$${service_name:regex}\", swarm_stack=~\"$${swarm_stack:regex}\", container=~\"$${container:regex}\"}[$__range])))",
          "legendFormat": "{{container}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Top containers by log count",
      "type": "bargauge"
    },
