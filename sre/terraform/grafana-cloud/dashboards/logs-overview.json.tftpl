  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "mcad",
    "logs",
    "loki",
    "sre",
    "terraform",
    "${environment}"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
