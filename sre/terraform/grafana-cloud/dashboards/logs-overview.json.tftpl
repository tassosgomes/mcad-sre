          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource_uid}"
        },
        "definition": "label_values({deployment_environment=\"${environment}\"}, service_namespace)",
