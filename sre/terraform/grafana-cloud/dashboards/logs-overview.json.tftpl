{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource_uid}"
          },
          "expr": "sum by (service_name) (rate({deployment_environment=\"${environment}\", service_namespace=~\"$${service_namespace:regex}\", service_name=~\"$${service_name:regex}\", swarm_stack=~\"$${swarm_stack:regex}\", container=~\"$${container:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource_uid}"
          },
          "expr": "sum by (service_name) (rate({deployment_environment=\"${environment}\", service_namespace=~\"$${service_namespace:regex}\", service_name=~\"$${service_name:regex}\", swarm_stack=~\"$${swarm_stack:regex}\", container=~\"$${container:regex}\"} |~ \"(?i)(error|exception|fatal|panic|failed|timeout|refused)\" [$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error log volume by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource_uid}"
          },
          "expr": "topk(10, sum by (service_name) (count_over_time({deployment_environment=\"${environment}\", service_namespace=~\"$${service_namespace:regex}\", service_name=~\"$${service_name:regex}\", swarm_stack=~\"$${swarm_stack:regex}\", container=~\"$${container:regex}\"}[$__range])))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Top services by log count",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
