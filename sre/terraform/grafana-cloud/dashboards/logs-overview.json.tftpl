          "expr": "topk(10, sum by (service_name) (count_over_time({deployment_environment=\"${environment}\", service_namespace=~\"$${service_namespace:regex}\", service_name=~\"$${service_name:regex}\", swarm_stack=~\"$${swarm_stack:regex}\", container=~\"$${container:regex}\"} |~ \"(?i)(error|exception|fatal|panic|failed|timeout|refused)\" [$__range])))",
